// ============================== Render ====================================
void render() {
  cv->fillScreen(TH.bg);
  switch (mode) {
    case M_DASH: drawBackdrop(); if (page == 0) pageClock(); else if (page == 1) pageWind(); else if (page == 2) pageSpeedDepth(); else if (page == PAGE_AIS) pageAis(); else pageBattery(); break;
    case M_MENU: drawMenu(); drawKeybar(); break;
    case M_EDIT: drawEdit(); drawKeybar(); break;
    case M_SCAN: drawScan(); drawKeybar(); break;
    case M_DIAG: drawDiag(); drawKeybar(); break;
    case M_SETUP: drawSetup(); drawKeybar(); break;
    case M_FACTORY: drawFactory(); drawKeybar(); break;
  }
  cv->flush();
  lastRender = millis();
  lastSig = sig();
  dirty = false;
}

uint32_t sig() {
  uint32_t h = 2166136261u;
  auto add = [&](const Val &v, float mul) {
    int32_t i = v.ok() ? (int32_t)lroundf(v.v * mul) : -99999;
    h = (h ^ (uint32_t)i) * 16777619u;
  };
  add(aws, 10); add(awa, 1); add(twaS, 1); add(twsS, 10); add(sog, 10); add(stw, 10); add(hdg, 1); add(depth, 10); add(keel, 10);
  if (page == PAGE_AIS) h = (h ^ aisRev) * 16777619u;
  if (page == PAGE_BATT) h = (h ^ (uint32_t)(batt.pct + 200) ^ (uint32_t)(batt.mv / 10) ^ (batt.charging << 20) ^ (batt.vbus << 21) ^ ((uint32_t)cfg.bright << 24)) * 16777619u;
  if (page == 0) h = (h ^ (uint32_t)time(nullptr)) * 16777619u;   // the clock is redrawn every second
  h = (h ^ (uint32_t)(srvUp ? 1 : 0) ^ (uint32_t)(page << 4) ^ (uint32_t)(mode << 6) ^ (uint32_t)(cfg.night << 9)) * 16777619u;
  return h;
}

// Screen copy over USB (command 'S'): half resolution, RGB565 in base64, "SCR565_BEGIN w h" ... "SCR565_END".
// Used to check the look from the PC without looking at the display.
void sendScreenPreview() {
  static const char b64[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
  const uint16_t *fb = cv->getFramebuffer();
  char line[80];
  int ln = 0, on = 0;
  uint8_t in[3];
  auto put = [&](uint8_t b) {
    in[on++] = b;
    if (on < 3) return;
    line[ln++] = b64[in[0] >> 2];
    line[ln++] = b64[((in[0] & 3) << 4) | (in[1] >> 4)];
    line[ln++] = b64[((in[1] & 15) << 2) | (in[2] >> 6)];
    line[ln++] = b64[in[2] & 63];
    on = 0;
    if (ln >= 76) { line[ln] = 0; Serial.println(line); ln = 0; }
  };
  Serial.printf("SCR565_BEGIN %d %d\n", SCR_W / 2, SCR_H / 2);
  for (int y = 0; y < SCR_H; y += 2)
    for (int x = 0; x < SCR_W; x += 2) {
      uint16_t p = fb[(uint32_t)y * SCR_W + x];
      put(p >> 8);
      put(p & 255);
    }
  if (on) {  // base64 padding
    uint8_t a = in[0], b = on > 1 ? in[1] : 0;
    line[ln++] = b64[a >> 2];
    line[ln++] = b64[((a & 3) << 4) | (b >> 4)];
    line[ln++] = on > 1 ? b64[(b & 15) << 2] : '=';
    line[ln++] = '=';
  }
  if (ln) { line[ln] = 0; Serial.println(line); }
  Serial.println("SCR565_END");
}

// ============================== Test bench over USB ====================
// Commands (one character): U/D = UP/DOWN, V/W = repeated UP/DOWN, O/L = short/long OK,
// B/K = short/long BACK, P = power off; "H<ip>:<port>\n" = temporary NMEA server;
// "C..." = configuration (see webcfg.h).
// The PC test bench no longer receives the screen copy (the display is now in colour).
void serialCmdLoop() {
  static String cmd;
  while (Serial.available()) {
    char c = (char)Serial.read();
    if (cmd.length()) {
      if (c == '\n' || c == '\r') {
        if (cmd[0] == 'C') { configCmd(cmd.substring(1)); cmd = ""; continue; }
        if (cmd[0] == 'N') { handleNmea(cmd.substring(1)); cmd = ""; continue; }   // NMEA sentence over USB (test)
        int colon = cmd.lastIndexOf(':');
        if (colon > 1) {
          if (!hostTemp) { savedHost = cfg.host; savedPort = cfg.port; hostTemp = true; }
          cfg.host = cmd.substring(1, colon);
          cfg.port = (uint16_t)cmd.substring(colon + 1).toInt();
          nmea.stop(); srvUp = false; lastConnTry = 0;
          Serial.printf("HOST %s:%u (temporary)\n", cfg.host.c_str(), cfg.port);
        }
        cmd = "";
      } else if (cmd.length() < 700) cmd += c;
      continue;
    }
    switch (c) {
      case 'U': handleKeys(EV_SHORT, EV_NONE, EV_NONE, EV_NONE); break;
      case 'V': handleKeys(EV_REPEAT, EV_NONE, EV_NONE, EV_NONE); break;
      case 'D': handleKeys(EV_NONE, EV_SHORT, EV_NONE, EV_NONE); break;
      case 'W': handleKeys(EV_NONE, EV_REPEAT, EV_NONE, EV_NONE); break;
      case 'O': handleKeys(EV_NONE, EV_NONE, EV_SHORT, EV_NONE); break;
      case 'L': handleKeys(EV_NONE, EV_NONE, EV_LONG, EV_NONE); break;
      case 'B': handleKeys(EV_NONE, EV_NONE, EV_NONE, EV_SHORT); break;
      case 'K': handleKeys(EV_NONE, EV_NONE, EV_NONE, EV_LONG); break;
      case 'P': powerOff(); break;
      case 'Y': if (cfg.vibPin >= 0) vibTest(); break;   // vibration test (4 s of pulses)
      case 'S': sendScreenPreview(); break;
      case 'T': cfg.night = !cfg.night; applyTheme(); dirty = true; break;   // test: day/night theme without saving
      case 'H': cmd = "H"; break;
      case 'C': cmd = "C"; break;
      case 'N': cmd = "N"; break;
    }
  }
}

// ============================== Menu logic ===========================
void startEdit(EditT t, bool clear = false) {
  editT = t;
  switch (t) {
    case E_PASS: editSet = CS_FULL; editBuf = clear ? String("") : cfg.pass; editMax = 63; curIdx = 0; break;
    case E_HOST: editSet = CS_NUM; editBuf = cfg.host; editMax = 15; curIdx = 1; break;
    case E_PORT: editSet = CS_NUM; editBuf = String(cfg.port); editMax = 5; curIdx = 3; break;
    case E_ALARM: editSet = CS_NUM; editBuf = String(cfg.depthAlarm, 1); editMax = 5; curIdx = 2; break;
    case E_CPA: editSet = CS_NUM; editBuf = String(cfg.cpaNm, 2); editMax = 5; curIdx = 2; break;
    case E_TCPA: editSet = CS_NUM; editBuf = String(cfg.tcpaMin, 0); editMax = 4; curIdx = 2; break;
  }
  mode = M_EDIT;
  dirty = true;
}

void finishEdit() {
  switch (editT) {
    case E_PASS: cfg.pass = editBuf; break;
    case E_HOST: cfg.host = editBuf; break;
    case E_PORT: { long p = editBuf.toInt(); cfg.port = (p >= 1 && p <= 65535) ? p : 10110; break; }
    case E_ALARM: cfg.depthAlarm = editBuf.toFloat(); break;
    case E_CPA: { float v = editBuf.toFloat(); cfg.cpaNm = (v >= 0.05f && v <= 5) ? v : AIS_CPA_NM; break; }
    case E_TCPA: { float v = editBuf.toFloat(); cfg.tcpaMin = (v >= 1 && v <= 120) ? v : AIS_TCPA_MIN; break; }
  }
  mode = M_MENU;
  dirty = true;
}

void doScan() {
  showMsg("Scanning WiFi...");
  int n = WiFi.scanNetworks();
  scanN = 0;
  for (int i = 0; i < n && scanN < 12; i++) {
    String s = WiFi.SSID(i);
    if (!s.length()) continue;
    bool dup = false;
    for (int k = 0; k < scanN; k++) if (scanSsid[k] == s) dup = true;
    if (dup) continue;
    scanSsid[scanN] = s;
    scanRssi[scanN] = WiFi.RSSI(i);
    scanN++;
  }
  WiFi.scanDelete();
  scanSel = 0;
  mode = M_SCAN;
  dirty = true;
}

void handleKeys(Ev eu, Ev ed, Ev eo, Ev eb) {
  switch (mode) {
    case M_DASH:
      if (eu == EV_SHORT) { page = (page + NUM_PAGES - 1) % NUM_PAGES; dirty = true; }
      if (ed == EV_SHORT) { page = (page + 1) % NUM_PAGES; dirty = true; }
      if (eo == EV_LONG) { mode = M_MENU; menuSel = 0; dirty = true; }
      if (eb == EV_SHORT) { cfg.night = !cfg.night; applyTheme(); saveCfg(); dirty = true; }
      break;
    case M_MENU:
      if (eu) menuSel = (menuSel + MENU_N - 1) % MENU_N;
      if (ed) menuSel = (menuSel + 1) % MENU_N;
      if (eo == EV_SHORT) {
        switch (menuSel) {
          case 0: doScan(); break;
          case 1: startEdit(E_PASS); break;
          case 2: startEdit(E_HOST); break;
          case 3: startEdit(E_PORT); break;
          case 4: startEdit(E_ALARM); break;
          case 5: startEdit(E_CPA); break;
          case 6: startEdit(E_TCPA); break;
          case 7: mode = M_DIAG; dirty = true; break;
          case 8: saveCfg(); showMsg("Saved", "Restarting..."); delay(800); ESP.restart(); break;
          case 9: showMsg("Restarting...", ""); delay(300); ESP.restart(); break;
          case 10: mode = M_FACTORY; dirty = true; break;
          case 11: powerOff(); break;
          case 12: loadCfg(); applyTheme(); mode = M_DASH; dirty = true; break;
        }
      }
      if (eb) { loadCfg(); applyTheme(); mode = M_DASH; dirty = true; }
      dirty = true;
      break;
    case M_EDIT: {
      int n = strlen(editSet);
      if (eu) curIdx = (curIdx + (eu == EV_REPEAT ? 2 : 1)) % n;
      if (ed) curIdx = ((curIdx - (ed == EV_REPEAT ? 2 : 1)) % n + n) % n;
      if (eo == EV_SHORT && editBuf.length() < editMax) editBuf += editSet[curIdx];
      if (eo == EV_LONG) finishEdit();
      if (eb == EV_SHORT && editBuf.length()) editBuf.remove(editBuf.length() - 1);
      if (eb == EV_LONG) mode = M_MENU;
      dirty = true;
      break;
    }
    case M_FACTORY:
      if (eo == EV_LONG) factoryReset();
      if (eb) { mode = M_MENU; dirty = true; }
      break;
    case M_SETUP:
      if (eo) { mode = M_MENU; menuSel = 0; dirty = true; }
      if (eb) { mode = M_DASH; dirty = true; }
      break;
    case M_DIAG:
      if (eo == EV_SHORT) dirty = true;
      if (eb) { mode = M_MENU; dirty = true; }
      break;
    case M_SCAN:
      if (eu && scanN) scanSel = (scanSel + scanN - 1) % scanN;
      if (ed && scanN) scanSel = (scanSel + 1) % scanN;
      if (eo == EV_SHORT && scanN) { cfg.ssid = scanSsid[scanSel]; startEdit(E_PASS, true); }
      if (eb) { mode = M_MENU; dirty = true; }
      dirty = true;
      break;
  }
}

// ============================== Touch: gestures and keys ======================
// On the dashboard: swipe = page, long press = menu, double tap = day/night theme.
// In the menus: the 4 virtual keys at the bottom (UP/DOWN repeat while held).
void touchEvents(Ev &eu, Ev &ed, Ev &eo, Ev &eb) {
  eu = ed = eo = eb = EV_NONE;
  uint32_t now = millis();
  bool down = tTouching;
  if (down && !tWasDown) {  // start of the touch
    tDown = now; tX0 = tX; tY0 = tY; tMoved = false; tLongFired = false;
    tKey = (mode != M_DASH && tY >= KEYBAR_Y) ? min(3, tX / (SCR_W / 4)) : -1;
    tInBright = (mode == M_DASH && page == PAGE_BATT && tY >= BR_ZONE_Y);
    dirty = true;
  }
  if (tInBright) {   // brightness adjustment: no page change, menu or double tap
    if (down) {
      int pct = constrain(5 + (tX - BR_TRACK_L) * 95 / (BR_TRACK_R - BR_TRACK_L), 5, 100);
      if (pct != cfg.bright) { cfg.bright = pct; applyBrightness(); dirty = true; }
    } else if (tWasDown) {
      saveCfg();
      tInBright = false;
      dirty = true;
    }
    tWasDown = down;
    return;
  }
  if (down) {
    if (abs(tX - tX0) > TAP_SLOP_PX || abs(tY - tY0) > TAP_SLOP_PX) tMoved = true;
    if (mode == M_DASH && !tMoved && !tLongFired && now - tDown >= LONG_PRESS_MS) {
      tLongFired = true;
      eo = EV_LONG;
    }
  } else if (tWasDown) {  // end of the touch
    if (mode == M_DASH) {
      int dx = tX - tX0;
      if (tMoved && abs(dx) >= SWIPE_MIN_PX && now - tDown <= SWIPE_MAX_MS) {
        if (dx < 0) ed = EV_SHORT; else eu = EV_SHORT;   // swipe left = next page
      } else if (!tMoved && !tLongFired) {  // short tap: two in a row = day/night
        if (lastTapT && now - lastTapT <= DOUBLE_TAP_MS && abs(tX0 - lastTapX) <= DOUBLE_TAP_PX &&
            abs(tY0 - lastTapY) <= DOUBLE_TAP_PX) {
          eb = EV_SHORT;
          lastTapT = 0;
        } else {
          lastTapT = now; lastTapX = tX0; lastTapY = tY0;
        }
      }
    }
    tKey = -1;
    dirty = true;
  }
  tWasDown = down;
  if (mode != M_DASH) {
    Ev ku = bUp.poll(down && tKey == 0);
    Ev kd = bDown.poll(down && tKey == 1);
    Ev ko = bOk.poll(down && tKey == 2);
    Ev kb = bBack.poll(down && tKey == 3);
    if (ku) eu = ku;
    if (kd) ed = kd;
    if (ko) eo = ko;
    if (kb) eb = kb;
  }
}

// ============================== Buttons, collision alarm, snooze ======
void screenSet(bool on) {
  if (on == screenOn) return;
  screenOn = on;
  if (on) { lcd->displayOn(); applyBrightness(); dirty = true; }
  else lcd->displayOff();
}
bool snoozed() { return snoozeUntil && (int32_t)(snoozeUntil - millis()) > 0; }
void showToast(const char *m, uint32_t ms = 3000) { toastMsg = m; toastUntil = millis() + ms; dirty = true; }
// External vibration motor (optional, the board has none): pulses while an alarm is active.
bool vibNow = false;          // pin currently driven high
uint32_t vibT = 0, vibTestUntil = 0;
void vibStop() { vibNow = false; vibTestUntil = 0; if (cfg.vibPin >= 0) digitalWrite(cfg.vibPin, LOW); }
void vibSetPin(int8_t pin) {   // switches the output pin (old one released, new one driven low)
  if (cfg.vibPin >= 0) { digitalWrite(cfg.vibPin, LOW); pinMode(cfg.vibPin, INPUT); }
  cfg.vibPin = pin; vibNow = false;
  if (pin >= 0) { pinMode(pin, OUTPUT); digitalWrite(pin, LOW); }
}
void vibTest() { vibTestUntil = millis() + 4000; vibT = millis() - ALERT_EVERY_MS; }   // 3 pulses, no alarm needed
void snoozeAlarm() {   // BOOT button: silences the alarm for 5 minutes
  if (!screenOn) screenSet(true);
  snoozeUntil = millis() + SNOOZE_MS;
  if (!snoozeUntil) snoozeUntil = 1;
  alertActive = false;
  vibStop();
  showToast("Alarm snoozed for 5 minutes");
  dirty = true;
}
void pwrShortPress() { screenSet(!screenOn); }   // short PWR press: screen on / off

void buttonsLoop() {
  static bool pwrDown = false, pwrFired = false, pwrArmed = false, bootDown = (digitalRead(BOOT_PIN) == LOW);   // BOOT already pressed at power-up: ignored until it is released
  static uint32_t pwrT = 0, bootT = 0, lowSince = 0;
  uint32_t now = millis();
  bool p = digitalRead(PWR_PIN) == HIGH;
  if (!p) { if (!lowSince) lowSince = now; if (now - lowSince > 200) pwrArmed = true; } else lowSince = 0;
  // "armed" only after seeing the button at rest: if the level were inverted it would never power off by itself
  if (pwrArmed) {
    if (p && !pwrDown) { pwrDown = true; pwrFired = false; pwrT = now; }
    if (p && pwrDown && !pwrFired && now - pwrT >= PWR_OFF_HOLD_MS) { pwrFired = true; powerOff(); }
    if (!p && pwrDown) {
      pwrDown = false;
      if (!pwrFired && now - pwrT >= 40) pwrShortPress();
    }
  }
  bool b = digitalRead(BOOT_PIN) == LOW;
  if (b && !bootDown && now - bootT > 150) { bootDown = true; bootT = now; snoozeAlarm(); }
  if (!b && bootDown && now - bootT > 40) bootDown = false;
}

void alertLoop() {
  static uint32_t lastChk = 0, lastSecond = 0;
  static bool phase = false;
  uint32_t now = millis();
  if (now - lastChk >= 1000) {
    lastChk = now;
    AisRow rows[AIS_MAX_ROWS];
    int n = aisBuild(rows, AIS_MAX_ROWS);
    bool risk = false;
    for (int i = 0; i < n; i++) if (rows[i].risk) risk = true;
    riskNow = risk;
    shallowNow = depthAlarming();
  }
  bool want = (riskNow || shallowNow) && !snoozed();
  if (want && !alertActive) {   // new alarm: turns the screen on and shows the AIS list
    alertActive = true;
    if (!screenOn) screenSet(true);
    if (mode == M_DASH) page = riskNow ? PAGE_AIS : 2;   // collision: AIS list; depth too low: SOG / depth page
    vibT = now - ALERT_EVERY_MS;
    dirty = true;
  } else if (!want && alertActive) {
    alertActive = false;
    dirty = true;
  }
  if (vibTestUntil && (int32_t)(vibTestUntil - now) <= 0) vibTestUntil = 0;
  if (cfg.vibPin >= 0) {   // motor pulses (if connected)
    bool vibWant = alertActive || vibTestUntil;
    if (vibWant && !vibNow && now - vibT >= ALERT_EVERY_MS) { vibNow = true; vibT = now; digitalWrite(cfg.vibPin, HIGH); }
    if (vibNow && (!vibWant || now - vibT >= ALERT_PULSE_MS)) { vibNow = false; digitalWrite(cfg.vibPin, LOW); }
  }
  bool ph = (now / 500) & 1;
  if (alertActive && ph != phase) { phase = ph; dirty = true; }   // flashing frame
  if ((snoozed() && (riskNow || shallowNow)) || (toastUntil && (int32_t)(toastUntil - now) > 0)) {
    if (now - lastSecond >= 1000) { lastSecond = now; dirty = true; }
  } else if (toastUntil && (int32_t)(toastUntil - now) <= 0) { toastUntil = 0; dirty = true; }
}

// ============================== Power off ===============================
// Screen off and deep sleep. To switch on again: BOOT or RESET button on the board.
void powerOff() {
  Serial.println("Power off");
  if (cv) { showMsg("Powering off...", ""); delay(600); }
  vibStop();
  nmea.stop();
  WiFi.disconnect(true, false);
  WiFi.mode(WIFI_OFF);
  cv->fillScreen(0);
  cv->flush();
  lcd->displayOff();
  delay(200);
  if (pmuShutdown()) { delay(1000); }   // real power off: switches on again with a single click on PWR
  esp_sleep_enable_ext0_wakeup((gpio_num_t)WAKE_PIN, 0);  // without PMU: deep sleep, the BOOT button (to ground) wakes it
  esp_deep_sleep_start();
}

#include "webcfg.h"

// ============================== Setup / loop ==============================
void haltWithError(const char *message) {
  Serial.println(message);
  while (true) delay(1000);
}

void setup() {
  Serial.begin(SERIAL_BAUD);
  Serial.printf("\nEssentialView S3 %s - reset reason %d (1 power-on, 3 software, 4 panic, 5-7 watchdog, 9 brownout)\n",
                FW_VERSION, (int)esp_reset_reason());
  loadCfg();
  applyTheme();
  applyTz();
  sntp_set_time_sync_notification_cb(onNtpSync);
  for (int i = 0; i < HN; i++) hist[i] = NAN;

  if (!lcd->begin()) haltWithError("LCD init failed (QSPI CO5300)");
  applyBrightness();
  PsramCanvas *pc = new PsramCanvas(SCR_W, SCR_H, lcd, cfg.rot == 2 ? 2 : 0);
  if (!pc->initBuffer()) haltWithError("Canvas: cannot allocate 400 KB in PSRAM (PSRAM = OPI? see README)");
  cv = pc;
  cv->begin(GFX_SKIP_OUTPUT_BEGIN);  // the panel is already initialised above: do not redo it (it would fail)

  touchInit();
  if (!tpOk) Serial.println("FT3168 not found: touch disabled");
  pinMode(BOOT_PIN, INPUT_PULLUP);
  pinMode(PWR_PIN, INPUT);
  if (cfg.vibPin >= 0) { pinMode(cfg.vibPin, OUTPUT); digitalWrite(cfg.vibPin, LOW); }
  pmuInit();
  pmuPoll();
  Serial.printf("PMU %s, battery %s %d%% %d mV\n", pmuOk ? "ok" : "NOT FOUND", batt.present ? "present" : "absent", batt.pct, batt.mv);
  time_t rt;
  if (rtcRead(rt)) { struct timeval tv = {rt, 0}; settimeofday(&tv, nullptr); Serial.println("RTC: time restored"); }
  else Serial.println("RTC: no valid time");

#if NMEA_WIRED
  Serial1.begin(NMEA_BAUD, SERIAL_8N1, NMEA_RX_PIN, NMEA_TX_PIN);
#endif

  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);
  if (cfg.ssid.length()) WiFi.begin(cfg.ssid.c_str(), cfg.pass.c_str());
  webSetup();

  if (!cfg.ssid.length()) mode = M_SETUP;  // first start: open network + instructions
  else if (!cfg.host.length() && !NMEA_WIRED) { mode = M_MENU; menuSel = 0; }
  render();
  Serial.println("EssentialView S3 ready");
}

void loop() {
  static bool ntpStarted = false;
  if (!ntpStarted && WiFi.status() == WL_CONNECTED) {
    ntpStarted = true;
    configTzTime(cfg.tz.c_str(), "pool.ntp.org", "time.google.com");
  }
  netLoop();
#if NMEA_WIRED
  serialLoop();
#endif
  serialCmdLoop();
  netCfgLoop();

  buttonsLoop();
  alertLoop();
  static uint32_t lastPmu = 0, lastRtcW = 0;
  if (millis() - lastPmu >= 3000) { lastPmu = millis(); pmuPoll(); }
  if (rtcDirty && millis() - lastRtcW >= 600000UL) { rtcDirty = false; lastRtcW = millis(); time_t tn = time(nullptr); if (clockValid()) rtcWrite(tn); }

  readTouch();
  static bool touchWake = false;
  Ev eu = EV_NONE, ed = EV_NONE, eo = EV_NONE, eb = EV_NONE;
  if (!screenOn) {                       // screen off: a touch switches it on again (and does nothing else)
    if (tTouching) { screenSet(true); touchWake = true; }
    tWasDown = tTouching;
  } else if (touchWake) {
    if (!tTouching) touchWake = false;
    tWasDown = tTouching;
  } else {
    touchEvents(eu, ed, eo, eb);
  }
  if (eu || ed || eo || eb) handleKeys(eu, ed, eo, eb);

  uint32_t now = millis();
  if (now - lastHist >= 10000) {
    lastHist = now;
    memmove(hist, hist + 1, (HN - 1) * sizeof(float));
    hist[HN - 1] = depth.ok() ? depth.v : NAN;
  }

  static uint32_t lastLog = 0;
  if (now - lastLog >= 5000) {
    lastLog = now;
    Serial.printf("WiFi=%s srv=%d rx=%lu ok=%lu badcs=%lu other=%lu\n", wifiStatusStr(), (int)srvUp,
                  (unsigned long)nRx, (unsigned long)nOk, (unsigned long)nBadCs, (unsigned long)nUnknown);
    float ta, ts;
    bool tr = getTrue(ta, ts);
    Serial.printf("Wind: app %.1f/%.1fkn true %.1f/%.1fkn (%s) stw=%.1f sog=%.1f\n", awa.v, aws.v,
                  tr ? ta : NAN, tr ? ts : NAN,
                  (twaS.ok(10000) && twsS.ok(10000)) ? "server" : (stw.ok() ? "calc STW" : (sog.ok() ? "calc SOG" : "none")),
                  stw.ok() ? stw.v : NAN, sog.ok() ? sog.v : NAN);
  }

  // redraw: immediately on an event, otherwise when the data change (or every FULL_REDRAW_MS)
  if (screenOn && now - lastRender >= 60 && (dirty || (now - lastRender >= REFRESH_MS && sig() != lastSig) ||
                                 now - lastRender >= FULL_REDRAW_MS)) {
    render();
  }
  delay(2);
}
