// ============================== Drawing helpers =========================
static inline void pol(float cx, float cy, float r, float deg, int &x, int &y) {
  float a = deg * DEG_TO_RAD;
  x = lroundf(cx + r * sinf(a));
  y = lroundf(cy - r * cosf(a));
}

// Smaller font (to make a value fit in a tile)
static const EsFont *smaller(const EsFont *f) {
  if (f == &F_NUM_XL) return &F_NUM_L;
  if (f == &F_NUM_L) return &F_NUM_M;
  if (f == &F_NUM_M) return &F_HEAD_M;
  if (f == &F_HEAD_M) return &F_HEAD;
  if (f == &F_HEAD_L) return &F_HEAD;
  return nullptr;
}

// Rectangle with a different radius for each corner (row-by-row fill): follows the rounded corners of the panel
static int cornerInset(int dy, int r) {
  if (r <= 0 || dy >= r) return 0;
  float d = r - dy - 0.5f;
  return (int)ceilf(r - sqrtf((float)r * r - d * d));
}
void roundRect4(int x, int y, int w, int h, int rtl, int rtr, int rbr, int rbl, uint16_t col) {
  for (int yy = 0; yy < h; yy++) {
    int il = max(cornerInset(yy, rtl), cornerInset(h - 1 - yy, rbl));
    int ir = max(cornerInset(yy, rtr), cornerInset(h - 1 - yy, rbr));
    if (w - il - ir > 0) cv->drawFastHLine(x + il, y + yy, w - il - ir, col);
  }
}

static uint16_t mix565(uint16_t base, uint16_t top, int wTop) {  // wTop 0..256
  int r = (((base >> 11) & 31) * (256 - wTop) + ((top >> 11) & 31) * wTop) >> 8;
  int g = (((base >> 5) & 63) * (256 - wTop) + ((top >> 5) & 63) * wTop) >> 8;
  int b = ((base & 31) * (256 - wTop) + (top & 31) * wTop) >> 8;
  return (uint16_t)((r << 11) | (g << 5) | b);
}

// The framebuffer is in physical orientation: with the screen rotated by 180 degrees the indexes are mirrored
static inline size_t fbi(int x, int y) {
  return cfg.rot == 2 ? (size_t)(SCR_H - 1 - y) * SCR_W + (SCR_W - 1 - x) : (size_t)y * SCR_W + x;
}

// Rectangle with different corners filled with transparency (alpha 0..256) over what is already there (glass effect)
void roundRectBlend(int x, int y, int w, int h, int rtl, int rtr, int rbr, int rbl, uint16_t col, int alpha) {
  uint16_t *fb = cv->getFramebuffer();
  // at night the widgets are opaque (original look of the red theme)
  if (!fb || cfg.night) { roundRect4(x, y, w, h, rtl, rtr, rbr, rbl, col); return; }
  for (int yy = 0; yy < h; yy++) {
    int il = max(cornerInset(yy, rtl), cornerInset(h - 1 - yy, rbl));
    int ir = max(cornerInset(yy, rtr), cornerInset(h - 1 - yy, rbr));
    for (int xx = x + il; xx < x + w - ir; xx++) {
      size_t i = fbi(xx, y + yy);
      fb[i] = mix565(fb[i], col, alpha);
    }
  }
}

// Only the border (thickness t) of a rectangle with different corners
void roundRectRing(int x, int y, int w, int h, int rtl, int rtr, int rbr, int rbl, uint16_t col, int t = 1) {
  for (int yy = 0; yy < h; yy++) {
    int il = max(cornerInset(yy, rtl), cornerInset(h - 1 - yy, rbl));
    int ir = max(cornerInset(yy, rtr), cornerInset(h - 1 - yy, rbr));
    int xs = x + il, xe = x + w - ir;
    if (xe <= xs) continue;
    if (yy < t || yy >= h - t) { cv->drawFastHLine(xs, y + yy, xe - xs, col); continue; }
    int iy = yy - t, ih = h - 2 * t;
    int jl = t + max(cornerInset(iy, max(rtl - t, 0)), cornerInset(ih - 1 - iy, max(rbl - t, 0)));
    int jr = t + max(cornerInset(iy, max(rtr - t, 0)), cornerInset(ih - 1 - iy, max(rbr - t, 0)));
    int is = x + max(jl, il), ie = x + w - max(jr, ir);
    if (is >= ie) { cv->drawFastHLine(xs, y + yy, xe - xs, col); continue; }
    if (is > xs) cv->drawFastHLine(xs, y + yy, is - xs, col);
    if (xe > ie) cv->drawFastHLine(ie, y + yy, xe - ie, col);
  }
}

// Soft glow (circle faded with transparency)
static void glow(int cx, int cy, int r, uint16_t col, int a0) {
  uint16_t *fb = cv->getFramebuffer();
  if (!fb) return;
  const long r2 = (long)r * r;
  for (int y = max(0, cy - r); y <= min(SCR_H - 1, cy + r); y++)
    for (int x = max(0, cx - r); x <= min(SCR_W - 1, cx + r); x++) {
      long dx = x - cx, dy = y - cy, d2 = dx * dx + dy * dy;
      if (d2 >= r2) continue;
      long f = (r2 - d2) * 256 / r2;
      int a = (int)(a0 * f / 256 * f / 256);
      if (a <= 0) continue;
      size_t i = fbi(x, y);
      fb[i] = mix565(fb[i], col, a);
    }
}

// Dashboard background: vertical gradient + two coloured glows, under the translucent tiles
void drawBackdrop() {
  if (cfg.night) { cv->fillScreen(TH.bg); return; }   // night (red) theme: solid background, no gradients or transparency
  const uint16_t bot = mix565(TH.bg, TH.pri, 64);
  for (int y = 0; y < SCR_H; y++) cv->drawFastHLine(0, y, SCR_W, mix565(TH.bg, bot, y * 256 / SCR_H));
  glow(340, 90, 190, TH.pri, 90);
  glow(40, 430, 200, TH.acc, 80);
}

// Tile: label at the top, value centred, unit at the bottom right.
// The value uses the given font and falls back to smaller ones until it fits in the tile.
// rtl/rtr/rbr/rbl: corner radius (large where the tile is near a corner of the panel, which is rounded).
void tile(int x, int y, int w, int h, const char *label, const String &val, const char *unit,
          uint16_t accent, const EsFont *f, uint16_t valCol = 0, bool deg = false,
          int rtl = 10, int rtr = 10, int rbr = 10, int rbl = 10) {
  roundRectBlend(x, y, w, h, rtl, rtr, rbr, rbl, TH.card, 168);   // glass: the background shows through
  roundRectRing(x, y, w, h, rtl, rtr, rbr, rbl, TH.border, 1);
  (void)accent;   // no coloured bar on the left
  tFont(&F_TEXT_S);
  tColor(TH.mfg);
  tC(label, x + w / 2, y + 9 + F_TEXT_S.capH);   // centred title
  int reserve = (unit && *unit) ? 28 : 0;
  if (unit && *unit) { tFont(&F_TEXT); tR(unit, x + w - (rbr > 12 ? (int)(rbr * 0.65f) : 8), y + h - 9); }
  String v = deg ? val + DEG : val;
  tFont(f);
  while ((tWidth(v) > w - 22 - reserve || esFont->capH > h - 30) && smaller(esFont)) tFont(smaller(esFont));
  int top = y + 22, bot = y + h - 7;
  tColor(valCol ? valCol : TH.fg);
  tC(v, x + 10 + (w - 10 - reserve) / 2, (top + bot) / 2 + esFont->capH / 2);
}

// Sector of a circular ring (filled with triangles)
void bandArc(float cx, float cy, float r0, float r1, float a0, float a1, uint16_t col) {
  int x0, y0, x1, y1, x2, y2, x3, y3;
  for (float a = a0; a < a1; a += 2) {
    pol(cx, cy, r0, a, x0, y0); pol(cx, cy, r1, a, x1, y1);
    pol(cx, cy, r0, a + 2, x2, y2); pol(cx, cy, r1, a + 2, x3, y3);
    cv->fillTriangle(x0, y0, x1, y1, x2, y2, col);
    cv->fillTriangle(x1, y1, x2, y2, x3, y3, col);
  }
}

void pointerTri(int cx, int cy, float ang, float rBase, float rTip, float half, uint16_t col) {
  int x0, y0, x1, y1, x2, y2;
  pol(cx, cy, rTip, ang, x0, y0);
  pol(cx, cy, rBase, ang - half, x1, y1);
  pol(cx, cy, rBase, ang + half, x2, y2);
  cv->fillTriangle(x0, y0, x1, y1, x2, y2, col);
}

void dashRadial(int cx, int cy, float ang, float r0, float r1, uint16_t col) {
  int xa, ya, xb, yb;
  for (float r = r0; r > r1; r -= 14) {
    pol(cx, cy, r, ang, xa, ya);
    pol(cx, cy, max(r - 8, r1), ang, xb, yb);
    cv->drawLine(xa, ya, xb, yb, col);
    cv->drawLine(xa + 1, ya, xb + 1, yb, col);
  }
}

