  const int w = SCR_W / 4;
  cv->fillRect(0, KEYBAR_Y - 2, SCR_W, SCR_H - KEYBAR_Y + 2, TH.card);
  cv->drawFastHLine(0, KEYBAR_Y - 2, SCR_W, TH.border);
  tFont(&F_HEAD);
  for (int i = 0; i < 4; i++) {
    bool pressed = tTouching && tKey == i;
    const int inset = (i == 0 || i == 3) ? 10 : 0;  // the keys at the ends stay away from the rounded corners
    int x = i * w + 5 + (i == 0 ? inset : 0), y = KEYBAR_Y + 7, bw = w - 10 - inset, bh = SCR_H - KEYBAR_Y - 22;
    cv->fillRoundRect(x, y, bw, bh, 12, pressed ? TH.pri : TH.bg);
    cv->drawRoundRect(x, y, bw, bh, 12, TH.pri);
    tColor(pressed ? TH.card : TH.pri);
    tCC(KEY_LABELS[i], x + bw / 2, y + bh / 2);
  }
}

// Instructions above the keys: one or two lines
void hint(const char *l1, const char *l2 = nullptr) {
  tFont(&F_TEXT_S);
  tColor(TH.mfg);
  if (l2) { tAt(10, KEYBAR_Y - 26, l1); tAt(10, KEYBAR_Y - 8, l2); }
  else tAt(10, KEYBAR_Y - 8, l1);
}

// No title bar: only the page dots at the bottom; when no NMEA data has arrived for
// more than DATA_STALE_MS (wind and navigation pages) the orange "SEGNALE PERSO" watermark appears.
bool dataLive() {
  return awa.ok() || aws.ok() || twaS.ok() || twsS.ok() || sog.ok() || stw.ok() || depth.ok() || hdg.ok();
}


// Semi-transparent text in the centre of the screen: the text is drawn, then the changed pixels
// (text + anti-aliasing edges) are blended with what was there before.
void drawWatermark(const char *text) {
  const int h = 56, y0 = (SCR_H - h) / 2;   // symmetric band: also valid with the screen rotated by 180 degrees
  uint16_t *fb = cv->getFramebuffer();
  const size_t n = (size_t)SCR_W * h;
  uint16_t *snap = fb ? (uint16_t *)heap_caps_malloc(n * 2, MALLOC_CAP_SPIRAM) : nullptr;
  if (snap) memcpy(snap, fb + (size_t)y0 * SCR_W, n * 2);
  tFont(&F_HEAD_L);
  tColor(TH.warn);
  tCC(text, SCR_W / 2, SCR_H / 2);
  if (!snap) return;
  uint16_t *dst = fb + (size_t)y0 * SCR_W;
  for (size_t i = 0; i < n; i++)
    if (dst[i] != snap[i]) dst[i] = mix565(snap[i], dst[i], 190);   // ~75% orange
  free(snap);
}

void drawStatusBar() {
  uint32_t now = millis();
  bool snz = snoozeUntil && (int32_t)(snoozeUntil - now) > 0;
  tFont(&F_TEXT_S);
  if (alertActive) {
    tColor(TH.bad);
    tCC("BOOT = SNOOZE 5 MIN", SCR_W / 2, SCR_H - 14);
  } else if (snz && (riskNow || shallowNow)) {
    int left = (int)((snoozeUntil - now) / 1000);
    char b[40]; snprintf(b, sizeof b, "ALARM SNOOZED  %d:%02d", left / 60, left % 60);
    tColor(TH.mfg);
    tCC(b, SCR_W / 2, SCR_H - 14);
  } else if (toastUntil && (int32_t)(toastUntil - now) > 0) {
    tColor(TH.mfg);
    tCC(toastMsg, SCR_W / 2, SCR_H - 14);
  } else {
    for (int i = 0; i < NUM_PAGES; i++) {
      int px = SCR_W / 2 + (int)((i - (NUM_PAGES - 1) * 0.5f) * 14);
      if (i == page) cv->fillCircle(px, SCR_H - 14, 3, TH.pri); else cv->drawCircle(px, SCR_H - 14, 3, TH.mfg);
    }
  }
  if (page > 0 && page != PAGE_BATT && !dataLive()) drawWatermark("SEGNALE PERSO");
  // collision alarm: flashing red frame following the curves of the screen
  if (alertActive && ((now / 500) & 1)) roundRectRing(0, 0, SCR_W, SCR_H, PANEL_CORNER_R, PANEL_CORNER_R, PANEL_CORNER_R, PANEL_CORNER_R, TH.bad, 6);
}

// ============================== Page 1: time and date ======================
// Tapered hand: from the tail (behind the centre) to the tip, max width w at half of the base.
static void drawHand(int cx, int cy, float deg, float len, float tail, float w, uint16_t col) {
  float a = deg * DEG_TO_RAD;
  float dx = sinf(a), dy = -cosf(a), nx = -dy, ny = dx;
  int tx = lroundf(cx + dx * len), ty = lroundf(cy + dy * len);
  int bx = lroundf(cx - dx * tail), by = lroundf(cy - dy * tail);
  int lx = lroundf(cx + nx * w), ly = lroundf(cy + ny * w);
  int rx = lroundf(cx - nx * w), ry = lroundf(cy - ny * w);
  cv->fillTriangle(tx, ty, lx, ly, rx, ry, col);
  cv->fillTriangle(bx, by, lx, ly, rx, ry, col);
}

// Analog clock without background tiles: thin ring, ticks, 12-3-6-9, hands, small date below.
void pageClock() {
  const int cx = SCR_W / 2, cy = 240;
  const float R = 176;
  bool ok = clockValid();
  time_t now = time(nullptr);
  struct tm tmv;
  localtime_r(&now, &tmv);

  // ring and ticks (60 minutes; every 5th longer and darker)
  cv->drawCircle(cx, cy, R, TH.border);
  cv->drawCircle(cx, cy, R - 1, TH.border);
  int x0, y0, x1, y1;
  for (int i = 0; i < 60; i++) {
    bool hr = (i % 5 == 0);
    pol(cx, cy, R - 8, i * 6, x0, y0);
    pol(cx, cy, R - (hr ? 26 : 16), i * 6, x1, y1);
    cv->drawLine(x0, y0, x1, y1, hr ? TH.fg : TH.mfg);
    if (hr) {
      cv->drawLine(x0 + 1, y0, x1 + 1, y1, TH.fg);
      cv->drawLine(x0, y0 + 1, x1, y1 + 1, TH.fg);
    }
  }
  // numbers 12 - 3 - 6 - 9
  tFont(&F_HEAD_L);
  tColor(TH.pri);
  int lx, ly;
  const char *nums[4] = {"12", "3", "6", "9"};
  for (int i = 0; i < 4; i++) {
    pol(cx, cy, R - 58, i * 90, lx, ly);
    tCC(nums[i], lx, ly);
  }

  if (ok) {
    float sec = tmv.tm_sec;
    float minA = (tmv.tm_min + sec / 60.0f) * 6.0f;
    float hrA = ((tmv.tm_hour % 12) + tmv.tm_min / 60.0f) * 30.0f;
    drawHand(cx, cy, hrA, R * 0.50f, 14, 5.5f, TH.fg);
    drawHand(cx, cy, minA, R * 0.76f, 16, 4.0f, TH.fg);
    drawHand(cx, cy, sec * 6.0f, R * 0.88f, 30, 1.3f, TH.pri);   // second hand, thin, with counterweight
    cv->fillCircle(cx, cy, 8, TH.fg);
    cv->fillCircle(cx, cy, 4, TH.pri);
  } else {
    tFont(&F_TEXT);
    tColor(TH.mfg);
    tCC("NO TIME", cx, cy);
  }

  // date, small, below the dial
  if (ok) {
    char buf[40];
    strftime(buf, sizeof buf, "%A  %d %B %Y", &tmv);
    tFont(&F_TEXT);
    tColor(TH.mfg);
    tCC(buf, cx, cy + R + 36);
  }
  drawStatusBar();
}

// ============================== Page 2: wind ===========================
// Dial with the wind rose rotating with the heading, AWA (blue triangle) and TWA (yellow triangle);
// in the centre heading, AWS and TWS (instead of the boat drawing). No AWA/TWA tiles: the angles are on the dial.
void pageWind() {
  const int cx = SCR_W / 2, cy = 246;   // large dial, centred
  const float R = 188, k = R / 228.0f;  // the dial is drawn in proportion to the old 800x480
  float hd = hdg.ok() ? hdg.v : 0;

  // disc and ring: starboard (green) / port (red) on the side the apparent wind comes from
  cv->fillCircle(cx, cy, R, TH.card);
  cv->drawCircle(cx, cy, R, TH.border);
  cv->drawCircle(cx, cy, R - 1, TH.border);
  if (awa.ok()) {
    if (awa.v >= 0) bandArc(cx, cy, R - 14 * k, R - 2, 5, 175, TH.ok);
    else            bandArc(cx, cy, R - 14 * k, R - 2, -175, -5, TH.bad);
  }
  cv->drawCircle(cx, cy, R - 14 * k, TH.border);

  // ticks and wind rose (rotates with the heading)
  int x0, y0, x1, y1;
  for (int c = 0; c < 360; c += 10) {
    float a = c - hd;
    bool lg = (c % 30 == 0);
    pol(cx, cy, R - 20 * k, a, x0, y0);
    pol(cx, cy, R - 20 * k - (lg ? 18 * k : 9 * k), a, x1, y1);
    cv->drawLine(x0, y0, x1, y1, TH.fg);
    if (lg) cv->drawLine(x0 + 1, y0, x1 + 1, y1, TH.fg);
  }
  for (int c = 0; c < 360; c += 30) {
    float a = c - hd;
    int lx, ly;
    pol(cx, cy, R - 54 * k, a, lx, ly);
    String s;
    bool card = (c % 90 == 0);
    if (c == 0) s = "N"; else if (c == 90) s = "E"; else if (c == 180) s = "S"; else if (c == 270) s = "W";
    else { char b[5]; snprintf(b, sizeof b, "%03d", c); s = b; }
    tFont(card ? &F_HEAD : &F_TEXT);
    tColor(card ? TH.pri : TH.fg);
    tCC(s, lx, ly);
  }

  // apparent wind: pointer + short dashed line (it stops before the values in the centre)
  float ta = 0, ts = 0;
  bool haveTrue = getTrue(ta, ts);
  if (awa.ok()) {
    dashRadial(cx, cy, awa.v, R - 52 * k, 100, TH.pri);
    pointerTri(cx, cy, awa.v, R - 16 * k, R - 52 * k, 3.6f, TH.pri);
  }
  // true wind: yellow triangle with a dark outline (over the blue pointer of the apparent wind)
  if (haveTrue) {
    int tx, ty, bx0, by0, bx1, by1;
    pol(cx, cy, R - 46 * k, ta, tx, ty);
    pol(cx, cy, R - 16 * k, ta - 3.4f, bx0, by0);
    pol(cx, cy, R - 16 * k, ta + 3.4f, bx1, by1);
    cv->fillTriangle(tx, ty, bx0, by0, bx1, by1, TH.yel);
    cv->drawTriangle(tx, ty, bx0, by0, bx1, by1, TH.fg);
  }

  // centre: heading, AWS (apparent), TWS (true)
  tFont(&F_TEXT_S);
  tColor(TH.mfg);
  tCC("HEADING", cx, cy - 88);
  tFont(&F_HEAD_M);
  tColor(TH.fg);
  if (hdg.ok()) {
    char b[5]; snprintf(b, sizeof b, "%03d", ((int)lroundf(hd)) % 360);
    tCC(String(b) + DEG + " " + cardinal(hd), cx, cy - 68);
  } else tCC("--", cx, cy - 68);

  tFont(&F_TEXT_S);
  tColor(TH.mfg);
  tCC("AWS  apparent  kn", cx, cy - 40);
  tFont(&F_NUM_L);
  tColor(TH.fg);
  tCC(fv(aws), cx, cy - 12);

  tFont(&F_TEXT_S);
  tColor(TH.mfg);
  tCC("TWS  true  kn", cx, cy + 20);
  tFont(&F_NUM_L);
  tColor(TH.fg);
  tCC(haveTrue ? String(ts, 1) : String("--"), cx, cy + 50);

  // legend below the dial: blue triangle = apparent wind, yellow triangle = true wind
  {
    const int ly = cy + (int)R + 26, ih = 12;
    tFont(&F_TEXT_S);
    int w1 = tWidth("Apparent wind"), w2 = tWidth("True wind");
    int total = 12 + 6 + w1 + 22 + 12 + 6 + w2;
    int lx = cx - total / 2;
    cv->fillTriangle(lx + 6, ly - ih / 2 - 1, lx, ly + ih / 2 - 1, lx + 12, ly + ih / 2 - 1, TH.pri);
    tColor(TH.fg);
    tAt(lx + 18, ly + F_TEXT_S.capH / 2 - 1, "Apparent wind");
    lx += 18 + w1 + 22;
    cv->fillTriangle(lx + 6, ly - ih / 2 - 1, lx, ly + ih / 2 - 1, lx + 12, ly + ih / 2 - 1, TH.yel);
    cv->drawTriangle(lx + 6, ly - ih / 2 - 1, lx, ly + ih / 2 - 1, lx + 12, ly + ih / 2 - 1, TH.fg);
    tColor(TH.fg);
    tAt(lx + 18, ly + F_TEXT_S.capH / 2 - 1, "True wind");
  }

  drawStatusBar();
}

