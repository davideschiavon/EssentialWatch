// ============================== On-board data =============================
struct Val {
  float v = NAN;
  uint32_t t = 0;
  void set(float x) { v = x; t = millis(); }
  bool ok(uint32_t maxAge = DATA_STALE_MS) const { return !isnan(v) && (millis() - t) < maxAge; }
};
Val awa, aws, twaS, twsS, sog, stw, hdg, depth, keel;  // degrees, knots, metres
uint32_t hdtT = 0;  // last HDT received: the true heading takes precedence over HDG/HDM

const int HN = 180;  // 30 minutes at 1 sample / 10 s
float hist[HN];
uint32_t lastHist = 0;

static float normAngle(float a) {
  while (a > 180) a -= 360;
  while (a < -180) a += 360;
  return a;
}

// True wind: from the server if present, otherwise computed from apparent wind + speed through water (STW).
// Without any speed there is no true wind: showing the apparent wind would be wrong.
bool getTrue(float &a, float &s) {
  if (twaS.ok(10000) && twsS.ok(10000)) { a = twaS.v; s = twsS.v; return true; }
  if (!aws.ok() || !awa.ok()) return false;
  if (!stw.ok() && !sog.ok()) return false;
  float bs = stw.ok() ? stw.v : sog.v;
  float r = awa.v * DEG_TO_RAD;
  float x = aws.v * cosf(r) - bs, y = aws.v * sinf(r);
  s = sqrtf(x * x + y * y);
  a = atan2f(y, x) * RAD_TO_DEG;
  return true;
}

// ============================== Time and date ================================
// Sources: NTP (if the WiFi has Internet) or the NMEA RMC/ZDA sentences (GPS UTC time), then the internal clock.
// The time zone is a POSIX string (cfg.tz), so daylight saving time is automatic.
uint32_t ntpT = 0, nmeaTimeT = 0;
bool ntpSynced = false;
static void onNtpSync(struct timeval *) { ntpT = millis(); ntpSynced = true; extern volatile bool rtcDirty; rtcDirty = true; }
void applyTz() { setenv("TZ", cfg.tz.c_str(), 1); tzset(); }
bool clockValid() { return time(nullptr) > 1700000000L; }
static bool ntpFresh() { return ntpSynced && millis() - ntpT < 3UL * 3600UL * 1000UL; }
const char *clockSource() {
  if (!clockValid()) return "none";
  if (ntpFresh()) return "NTP";
  if (nmeaTimeT && millis() - nmeaTimeT < 20000) return "GPS";
  return "internal clock";
}
static int64_t daysFromCivil(int y, int m, int d) {  // days since 1970-01-01
  y -= m <= 2;
  int era = (y >= 0 ? y : y - 399) / 400;
  unsigned yoe = (unsigned)(y - era * 400);
  unsigned doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
  unsigned doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
  return (int64_t)era * 146097 + (int64_t)doe - 719468;
}
static void nmeaTime(const String &hms, int d, int m, int y) {  // hhmmss(.ss) UTC + date
  if (hms.length() < 6 || y < 2024 || m < 1 || m > 12 || d < 1 || d > 31) return;
  nmeaTimeT = millis();
  if (ntpFresh()) return;  // NTP takes precedence
  time_t t = (time_t)(daysFromCivil(y, m, d) * 86400 + hms.substring(0, 2).toInt() * 3600L +
                      hms.substring(2, 4).toInt() * 60L + hms.substring(4, 6).toInt());
  time_t cur = time(nullptr);
  if (!clockValid() || labs((long)(cur - t)) > 1) {
    struct timeval tv = {t, 0};
    settimeofday(&tv, nullptr);
    extern volatile bool rtcDirty;
    rtcDirty = true;   // the RTC is updated (at most every 10 minutes)
  }
}

// ============================== PMU AXP2101, RTC PCF85063 ==================
static bool i2cRead(uint8_t addr, uint8_t reg, uint8_t *buf, int n) {
  Wire.beginTransmission(addr);
  Wire.write(reg);
  if (Wire.endTransmission(false) != 0) return false;
  if (Wire.requestFrom((int)addr, n) != n) return false;
  for (int i = 0; i < n; i++) buf[i] = Wire.read();
  return true;
}
static bool i2cWrite(uint8_t addr, uint8_t reg, const uint8_t *buf, int n) {
  Wire.beginTransmission(addr);
  Wire.write(reg);
  for (int i = 0; i < n; i++) Wire.write(buf[i]);
  return Wire.endTransmission() == 0;
}

struct Batt { bool ok = false, present = false, charging = false, vbus = false; int pct = -1, mv = 0; } batt;
bool pmuOk = false;

void pmuInit() {
  uint8_t v;
  pmuOk = i2cRead(PMU_ADDR, 0x00, &v, 1);
  if (!pmuOk) return;
  if (i2cRead(PMU_ADDR, 0x30, &v, 1)) { v |= 0x01; i2cWrite(PMU_ADDR, 0x30, &v, 1); }   // battery voltage ADC
  if (i2cRead(PMU_ADDR, 0x18, &v, 1)) { v |= 0x08; i2cWrite(PMU_ADDR, 0x18, &v, 1); }   // gauge (percentage)
}

void pmuPoll() {
  uint8_t r[2], p, vb[2];
  if (!pmuOk || !i2cRead(PMU_ADDR, 0x00, r, 2)) { batt.ok = false; return; }
  batt.ok = true;
  batt.present = r[0] & 0x08;
  batt.vbus = r[0] & 0x20;
  batt.charging = ((r[1] >> 5) & 3) == 1;
  batt.pct = -1; batt.mv = 0;
  if (batt.present) {
    if (i2cRead(PMU_ADDR, 0xA4, &p, 1)) batt.pct = constrain((int)p, 0, 100);
    if (i2cRead(PMU_ADDR, 0x34, vb, 2)) batt.mv = ((vb[0] & 0x3F) << 8) | vb[1];
  }
}

// really powers the watch off (a single click on PWR switches it on again)
bool pmuShutdown() {
  uint8_t v;
  if (!pmuOk || !i2cRead(PMU_ADDR, 0x10, &v, 1)) return false;
  v |= 0x01;
  return i2cWrite(PMU_ADDR, 0x10, &v, 1);
}

static uint8_t bcd2(uint8_t b) { return (b >> 4) * 10 + (b & 15); }
static uint8_t tobcd(int v) { return ((v / 10) << 4) | (v % 10); }
volatile bool rtcDirty = false;   // must be written to the RTC (NTP/GPS corrected the time)

bool rtcRead(time_t &utc) {
  uint8_t b[7];
  if (!i2cRead(RTC_ADDR, 0x04, b, 7) || (b[0] & 0x80)) return false;   // bit 7 = oscillator stopped: time not valid
  int y = 2000 + bcd2(b[6]), mo = bcd2(b[5] & 0x1F), d = bcd2(b[3] & 0x3F);
  int h = bcd2(b[2] & 0x3F), mi = bcd2(b[1] & 0x7F), se = bcd2(b[0] & 0x7F);
  if (y < 2024 || mo < 1 || mo > 12 || d < 1 || d > 31) return false;
  utc = (time_t)(daysFromCivil(y, mo, d) * 86400 + h * 3600L + mi * 60L + se);
  return true;
}
bool rtcWrite(time_t utc) {
  struct tm t;
  gmtime_r(&utc, &t);
  uint8_t b[7] = {tobcd(t.tm_sec), tobcd(t.tm_min), tobcd(t.tm_hour), tobcd(t.tm_mday), (uint8_t)t.tm_wday,
                  tobcd(t.tm_mon + 1), tobcd(t.tm_year - 100)};
  return i2cWrite(RTC_ADDR, 0x04, b, 7);
}
// set the time by hand (web page): system clock + battery-backed RTC
bool setClockEpoch(time_t t) {
  struct timeval tv = {t, 0};
  settimeofday(&tv, nullptr);
  ntpSynced = false;
  nmeaTimeT = 0;
  return rtcWrite(t);
}

// ============================== AIS =======================================
// Decoding as in EssentialSail (NMEAParser.kt): 6-bit payload (char-48, minus 8 if >40), messages
// 1/2/3 and 18/19 = position, 5 / 19 / 24A = name (6 bit, '@' = end), multi-fragment sentences reassembled by sequence number.
// Own position from RMC/GLL/GGA (or from VDO). CPA/TCPA and thresholds: as in EssentialSail.
const int AIS_MAX = 48;
AisT ais[AIS_MAX];
uint32_t aisRev = 0;                 // changes on every accepted AIS message (to trigger a redraw)
double ownLat = 0, ownLon = 0;
uint32_t ownPosT = 0;
Val cogV;                            // course over ground (RMC / VTG)
bool ownPosOk() { return ownPosT && millis() - ownPosT < 15000; }

static bool nmeaLatLon(const String &la, const String &ns, const String &lo, const String &ew, double &lat, double &lon) {
  if (la.length() < 4 || lo.length() < 5 || !ns.length() || !ew.length()) return false;
  double a = la.toDouble(), b = lo.toDouble();
  int ad = (int)(a / 100), bd = (int)(b / 100);
  lat = ad + (a - ad * 100) / 60.0;
  lon = bd + (b - bd * 100) / 60.0;
  if (ns[0] == 'S') lat = -lat;
  if (ew[0] == 'W') lon = -lon;
  return fabs(lat) <= 90 && fabs(lon) <= 180;
}
static void setOwnPos(double lat, double lon) { ownLat = lat; ownLon = lon; ownPosT = millis(); }

static AisT *aisFind(uint32_t mmsi) {
  AisT *free_ = nullptr, *oldest = &ais[0];
  for (int i = 0; i < AIS_MAX; i++) {
    if (ais[i].mmsi == mmsi) return &ais[i];
    if (!ais[i].mmsi && !free_) free_ = &ais[i];
    if (ais[i].tSeen < oldest->tSeen) oldest = &ais[i];
  }
  AisT *t = free_ ? free_ : oldest;   // table full: the boat heard least recently is replaced
  memset(t, 0, sizeof(AisT));
  t->mmsi = mmsi;
  return t;
}

static uint8_t aisBits[100];   // one 6-bit value per character
static int aisBitLen = 0;
static uint32_t aisU(int start, int len) {
  uint32_t v = 0;
  for (int i = 0; i < len; i++) {
    int b = start + i;
    v = (v << 1) | ((aisBits[b / 6] >> (5 - b % 6)) & 1);
  }
  return v;
}
static int32_t aisS(int start, int len) {
  int64_t v = aisU(start, len);
  if (v >= ((int64_t)1 << (len - 1))) v -= ((int64_t)1 << len);
  return (int32_t)v;
}
static void aisText(int start, int chars, char *out) {   // 6-bit ASCII: <32 -> +64, '@' = end, trailing spaces removed
  int n = 0;
  for (int i = 0; i < chars; i++) {
    int cc = aisU(start + i * 6, 6);
    char ch = cc < 32 ? (char)(cc + 64) : (char)cc;
    if (ch == '@') break;
    out[n++] = ch;
  }
  while (n > 0 && out[n - 1] == ' ') n--;
  out[n] = 0;
}

static void aisSetName(uint32_t mmsi, int start) {
  char nm[24];
  aisText(start, 20, nm);
  if (!nm[0]) return;
  AisT *t = aisFind(mmsi);
  strncpy(t->name, nm, 20);
  t->name[20] = 0;
  t->tSeen = millis();
  aisRev++;
}

static void aisPosition(uint32_t mmsi, bool own, int sogS, int lonS, int latS, int cogS) {
  double lon = aisS(lonS, 28) / 600000.0, lat = aisS(latS, 27) / 600000.0;
  if (fabs(lat) > 90.0001 || fabs(lon) > 180.0001) return;     // 91 / 181 = not available
  if (own) { setOwnPos(lat, lon); return; }
  uint32_t sg = aisU(sogS, 10), cg = aisU(cogS, 12);
  AisT *t = aisFind(mmsi);
  t->lat = lat; t->lon = lon;
  t->sog = sg >= 1023 ? 0 : sg / 10.0f;
  t->cog = cg >= 3600 ? 0 : cg / 10.0f;
  t->hasPos = true;
  t->tPos = t->tSeen = millis();
  aisRev++;
}

static void aisMessage(bool own) {
  if (aisBitLen < 38) return;
  int type = aisU(0, 6);
  uint32_t mmsi = aisU(8, 30);
  if (!mmsi) return;
  switch (type) {
    case 1: case 2: case 3:
      if (aisBitLen >= 168) aisPosition(mmsi, own, 50, 61, 89, 116);
      break;
    case 18:
      if (aisBitLen >= 168) aisPosition(mmsi, own, 46, 57, 85, 112);
      break;
    case 19:   // extended class B: position + name
      if (aisBitLen >= 263) { if (!own) aisSetName(mmsi, 143); aisPosition(mmsi, own, 46, 57, 85, 112); }
      break;
    case 5:
      if (aisBitLen >= 232 && !own) aisSetName(mmsi, 112);
      break;
    case 24:   // class B static data: part A (0) contains the name (even when it arrives in 160 bits)
      if (aisBitLen >= 160 && aisU(38, 2) == 0 && !own) aisSetName(mmsi, 40);
      break;
  }
}

// !AIVDM,<fragments>,<n>,<seq>,<channel>,<payload>,<fill>
struct AisFrag { bool used; bool own; char seq[4]; String data; };
static AisFrag aisFrags[4];

static void aisSentence(const String *f, int n, bool own) {
  if (n < 7) return;
  int total = f[1].toInt(), num = f[2].toInt();
  String payload = f[5];
  if (total < 1 || num < 1 || !payload.length()) return;
  String full;
  if (total == 1) {
    full = payload;
  } else {
    char seq[4] = {0};
    strncpy(seq, f[3].c_str(), 3);
    AisFrag *slot = nullptr;
    for (auto &fr : aisFrags) if (fr.used && fr.own == own && !strcmp(fr.seq, seq)) slot = &fr;
    if (num == 1) {
      if (!slot) for (auto &fr : aisFrags) if (!fr.used) { slot = &fr; break; }
      if (!slot) slot = &aisFrags[0];
      slot->used = true; slot->own = own; strcpy(slot->seq, seq); slot->data = payload;
      return;
    }
    if (!slot) return;
    slot->data += payload;
    if (num < total) return;
    full = slot->data;
    slot->used = false; slot->data = "";
  }
  aisBitLen = 0;
  for (size_t i = 0; i < full.length() && aisBitLen + 6 <= (int)sizeof(aisBits) * 6; i++) {
    int v = (uint8_t)full[i] - 48;
    if (v > 40) v -= 8;
    if (v < 0 || v > 63) continue;
    aisBits[aisBitLen / 6] = (uint8_t)v;
    aisBitLen += 6;
  }
  aisMessage(own);
}

// List of the boats to show, sorted: first those at risk, then by distance.
int aisBuild(AisRow *rows, int maxRows) {
  if (!ownPosOk()) return 0;
  float oSog = sog.ok() ? sog.v : 0;
  float oCog = cogV.ok() ? cogV.v : (hdg.ok() ? hdg.v : 0);
  float ovx = oSog / 60.0f * sinf(oCog * DEG_TO_RAD), ovy = oSog / 60.0f * cosf(oCog * DEG_TO_RAD);   // nm/min
  int n = 0;
  uint32_t now = millis();
  for (int i = 0; i < AIS_MAX; i++) {
    const AisT &t = ais[i];
    if (!t.mmsi || !t.hasPos || now - t.tPos > AIS_STALE_MS) continue;
    double px = (t.lon - ownLon) * 60.0 * cos(ownLat * DEG_TO_RAD);   // nm towards east
    double py = (t.lat - ownLat) * 60.0;                                              // nm towards north
    float dist = (float)sqrt(px * px + py * py);
    float brg = (float)(atan2(px, py) * RAD_TO_DEG);
    if (brg < 0) brg += 360;
    float tvx = t.sog / 60.0f * sinf(t.cog * DEG_TO_RAD), tvy = t.sog / 60.0f * cosf(t.cog * DEG_TO_RAD);
    double vx = tvx - ovx, vy = tvy - ovy, vv = vx * vx + vy * vy;
    float cpa = dist, tcpa = -1;
    if (vv * 3600.0 >= 0.01) {   // < 0.1 knots of relative motion: not approaching (as in CollisionMath)
      double tm = -(px * vx + py * vy) / vv;       // minutes to the closest point of approach
      if (tm > 0) { cpa = (float)sqrt((px + vx * tm) * (px + vx * tm) + (py + vy * tm) * (py + vy * tm)); tcpa = (float)tm; }
    }
    bool risk = (cpa < cfg.cpaNm && tcpa > 0 && tcpa < cfg.tcpaMin) || dist < cfg.cpaNm;
    if (!risk && dist > AIS_WATCH_NM) continue;
    AisRow r = {&t, dist, brg, cpa, tcpa, risk};
    int pos = n;   // sorted insertion
    while (pos > 0 && ((r.risk && !rows[pos - 1].risk) || (r.risk == rows[pos - 1].risk && r.dist < rows[pos - 1].dist))) pos--;
    if (pos >= maxRows) continue;
    for (int k = min(n, maxRows - 1); k > pos; k--) rows[k] = rows[k - 1];
    rows[pos] = r;
    if (n < maxRows) n++;
  }
  return n;
}

// ============================== NMEA 0183 =================================
// Sentences: MWV, VWR, VWT (wind) - VTG, RMC (SOG) - VHW (STW) - HDT, HDG, HDM (heading) - DBT, DPT, DBK (depth)
WiFiClient nmea;
bool srvUp = false;
uint32_t nRx = 0, nOk = 0, nBadCs = 0, nUnknown = 0, nConnTry = 0;
String lastLine;
uint32_t lastConnTry = 0;
String lineBuf;
const float KMH2KN = 0.539957f, MS2KN = 1.943844f, MPH2KN = 0.868976f;

static float toKnots(float v, char unit) {
  switch (unit) {
    case 'M': return v * MS2KN;
    case 'K': return v * KMH2KN;
    case 'S': return v * MPH2KN;
    default: return v;  // 'N' knots
  }
}

static float wrap360(float d) {
  while (d < 0) d += 360;
  while (d >= 360) d -= 360;
  return d;
}

static bool nmeaChecksumOk(const String &l) {
  if (l.length() < 6 || (l[0] != '$' && l[0] != '!')) return false;
  int star = l.indexOf('*');
  if (star < 0) return true;  // no checksum: accept
  uint8_t c = 0;
  for (int i = 1; i < star; i++) c ^= (uint8_t)l[i];
  return (uint8_t)strtol(l.substring(star + 1, star + 3).c_str(), nullptr, 16) == c;
}

static int splitFields(const String &l, String *f, int maxF) {
  int end = l.indexOf('*');
  if (end < 0) end = l.length();
  int n = 0, start = 1;
  while (n < maxF && start <= end) {
    int c = l.indexOf(',', start);
    if (c < 0 || c > end) c = end;
    f[n++] = l.substring(start, c);
    start = c + 1;
  }
  return n;
}

void handleNmea(const String &raw) {
  nRx++;
  lastLine = raw.substring(0, 70);
  String l = raw;
  int d0 = l.indexOf('$'), d1 = l.indexOf('!');
  if (d0 < 0 || (d1 >= 0 && d1 < d0)) d0 = d1;
  if (d0 > 0) l = l.substring(d0);
  if (!nmeaChecksumOk(l)) { nBadCs++; return; }
  String f[16];
  int n = splitFields(l, f, 16);
  if (n < 2 || f[0].length() < 5) return;
  String t = f[0].substring(f[0].length() - 3);
  auto has = [&](int i) { return i < n && f[i].length() > 0; };
  bool known = (t == "MWV" || t == "VWR" || t == "VWT" || t == "VTG" || t == "RMC" || t == "VHW" || t == "HDT" ||
                t == "HDG" || t == "HDM" || t == "DBT" || t == "DPT" || t == "DBK" || t == "ZDA" || t == "GLL" || t == "GGA" || t == "VDM" || t == "VDO");
  if (known) nOk++; else nUnknown++;

  if (t == "MWV") {                    // angle, R/T, speed, unit, status
    if (!has(1) || !has(2) || !has(3)) return;
    if (has(5) && f[5][0] != 'A') return;
    float a = normAngle(f[1].toFloat());
    float sp = toKnots(f[3].toFloat(), has(4) ? f[4][0] : 'N');
    if (f[2][0] == 'R') { awa.set(a); aws.set(sp); }
    else { twaS.set(a); twsS.set(sp); }
  } else if (t == "VWR" || t == "VWT") {  // angle 0-180, L/R, knots
    if (!has(1) || !has(2) || !has(3)) return;
    float a = f[1].toFloat();
    if (f[2][0] == 'L') a = -a;
    a = normAngle(a);
    float sp = f[3].toFloat();
    if (t == "VWR") { awa.set(a); aws.set(sp); }
    else { twaS.set(a); twsS.set(sp); }
  } else if (t == "VTG") {             // true course = field 1, SOG knots = field 5
    if (has(1)) cogV.set(wrap360(f[1].toFloat()));
    if (has(5)) sog.set(f[5].toFloat());
  } else if (t == "RMC") {             // time = field 1, status = 2, SOG knots = field 7, date ddmmyy = 9
    if (has(2) && f[2][0] == 'A' && has(7)) sog.set(f[7].toFloat());
    if (has(2) && f[2][0] == 'A') {
      double la, lo;
      if (n > 6 && nmeaLatLon(f[3], f[4], f[5], f[6], la, lo)) setOwnPos(la, lo);
      if (has(8)) cogV.set(wrap360(f[8].toFloat()));
    }
    if (has(1) && has(2) && f[2][0] == 'A' && has(9) && f[9].length() >= 6)
      nmeaTime(f[1], f[9].substring(0, 2).toInt(), f[9].substring(2, 4).toInt(), 2000 + f[9].substring(4, 6).toInt());
  } else if (t == "GLL") {             // lat, N/S, lon, E/W, time, status
    double la, lo;
    if (n > 4 && (!has(6) || f[6][0] == 'A') && nmeaLatLon(f[1], f[2], f[3], f[4], la, lo)) setOwnPos(la, lo);
  } else if (t == "GGA") {             // time, lat, N/S, lon, E/W, quality
    double la, lo;
    if (n > 6 && has(6) && f[6] != "0" && nmeaLatLon(f[2], f[3], f[4], f[5], la, lo)) setOwnPos(la, lo);
  } else if (t == "VDM" || t == "VDO") {   // AIS
    aisSentence(f, n, t == "VDO");
  } else if (t == "ZDA") {             // hhmmss, day, month, year
    if (has(1) && has(2) && has(3) && has(4)) nmeaTime(f[1], f[2].toInt(), f[3].toInt(), f[4].toInt());
  } else if (t == "VHW") {             // hdgT,T,hdgM,M,stw,N,stw,K
    if (has(5)) stw.set(f[5].toFloat());
    else if (has(7)) stw.set(f[7].toFloat() * KMH2KN);
  } else if (t == "HDT") {
    if (has(1)) { hdg.set(wrap360(f[1].toFloat())); hdtT = millis(); }
  } else if (t == "HDG" || t == "HDM") {  // magnetic: only if HDT is missing
    if (has(1) && (hdtT == 0 || millis() - hdtT > DATA_STALE_MS)) hdg.set(wrap360(f[1].toFloat()));
  } else if (t == "DBT") {             // feet, f, metres, M
    if (has(3)) depth.set(f[3].toFloat());
    else if (has(1)) depth.set(f[1].toFloat() * 0.3048f);
  } else if (t == "DPT") {             // depth m, offset m
    if (has(1)) {
      float d = f[1].toFloat();
      depth.set(d);
      if (has(2)) {
        float off = f[2].toFloat();
        if (off < 0) keel.set(d + off);  // negative offset = transducer-keel
      }
    }
  } else if (t == "DBK") {             // depth below keel, metres = field 3
    if (has(3)) keel.set(f[3].toFloat());
  }
}

void netLoop() {
  if (WiFi.status() != WL_CONNECTED) {
    srvUp = false;
    nmea.stop();
    return;
  }
  if (!nmea.connected()) {
    srvUp = false;
    uint32_t now = millis();
    if (cfg.host.length() && now - lastConnTry > 3000) {
      lastConnTry = now;
      nConnTry++;
      if (nmea.connect(cfg.host.c_str(), cfg.port, 500)) {
        srvUp = true; lineBuf = "";
        Serial.printf("NMEA: connected to %s:%u\n", cfg.host.c_str(), cfg.port);
      } else {
        Serial.printf("NMEA: connect to %s:%u failed (try %lu)\n", cfg.host.c_str(), cfg.port, (unsigned long)nConnTry);
      }
    }
    return;
  }
  srvUp = true;
  int guard = 0;
  while (nmea.available() && guard++ < 600) {
    char c = (char)nmea.read();
    if (c == '\n' || c == '\r') {
      if (lineBuf.length()) { handleNmea(lineBuf); lineBuf = ""; }
    } else if (lineBuf.length() < 120) {
      lineBuf += c;
    }
  }
}

